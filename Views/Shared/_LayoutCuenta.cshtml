<!DOCTYPE html>
<html lang="es-AR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] | MoneyUp</title>
    <link rel="icon" type="image/png" href="~/images/logo-original.png" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/cuenta.css" asp-append-version="true" />
</head>
<body class="auth-layout">
    <div class="auth-page-shell">
        <header class="account-header">
            <div class="account-header-inner">
                <a asp-controller="Home" asp-action="Index" class="account-brand" aria-label="Volver al inicio">
                    <span>Money<span>Up</span></span>
                </a>
                <button type="button" class="account-bell" aria-label="Notificaciones">
                    <span class="icon icon-notificaciones" aria-hidden="true"></span>
                </button>
            </div>
        </header>

        <main id="contenido" class="account-main" tabindex="-1">
            @RenderBody()
        </main>

        <footer class="account-footer">
            <div class="account-footer-inner">
                <div class="account-footer-brand">
                    <span class="footer-mark">MoneyUp</span>
                    <div class="account-footer-copy">Organizá tu dinero, alcanzá tus metas.</div>
                </div>
                <div class="account-footer-links">
                    <span>Teléfono: +54 11 1234 5678</span>
                    <span>Instagram</span>
                    <span>Mail</span>
                    <span>Ayuda</span>
                </div>
                <div class="account-footer-copyright">© MoneyUp — Proyecto educativo</div>
            </div>
        </footer>
    </div>

    <script src="~/js/site.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
